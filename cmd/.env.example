# Proxy
MYSQL_PROXY_ADDR=:3307
MYSQL_PROXY_USERNAME=proxy
MYSQL_PROXY_PASSWORD=proxy-password

# MySQL
MYSQL_ADDR=127.0.0.1:3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
# 后端 TLS 的 CA 证书文件路径（PEM 格式）。有值时用该 CA 严格校验后端证书，
# 优先级高于 MYSQL_TLS_SKIP_VERIFY；留空则按 MYSQL_TLS_SKIP_VERIFY 决定。
MYSQL_TLS_CA=
# 后端启用 TLS 时，是否跳过证书验证（默认 true；仅在 MYSQL_TLS_CA 为空时生效）
MYSQL_TLS_SKIP_VERIFY=true

# Connection
MYSQL_CONNECT_TIMEOUT=5s
MYSQL_AUTH_TIMEOUT=5s
